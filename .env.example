# Meshtastic Configuration File
# Copy this file to .env and fill in your values

# Absolute path to the local meshtastic config.yaml file
MESHTASTIC_CONFIG_PATH=/path/to/your/meshtastic/config.yaml

# Alerts Module AI API Keys (at least one required for alerts module)
# Primary recommendations (free tiers):
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Additional providers:
MISTRAL_API_KEY=your_mistral_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Alert channel configuration
ALERT_CHANNEL_NAME=your_channel_name
ALERT_MIN_HOUR_OF_DAY=20

# Exclude individual alert providers (uncomment to disable)
# EXCLUDE_ALERT_RCB=1
# EXCLUDE_ALERT_IMGW=1
# EXCLUDE_ALERT_POZ=1
# EXCLUDE_ALERT_SYNOP=1
# EXCLUDE_ALERT_AIWEATHER=1
